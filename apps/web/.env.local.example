# Firebase 클라이언트 (NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ant-cleaning.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ant-cleaning
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ant-cleaning.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App Check — reCAPTCHA v3 사이트 키. 빈값이면 App Check 비활성 (로컬 개발에서 OK)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# 로컬 디버그 토큰: "true"면 자동 생성, 또는 콘솔에 등록한 토큰 문자열
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=

# 로컬 Firebase 에뮬레이터 연동 스위치.
# "true" 면 Auth/Firestore/Storage/Functions 를 로컬 에뮬레이터(127.0.0.1)에 연결한다.
# (이때 NEXT_PUBLIC_FIREBASE_API_KEY 등은 플레이스홀더 값이어도 됨)
# 실제 클라우드 사용 시에는 제거하거나 false 로 둔다.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=

# 사이트 URL (sitemap, robots, 이메일 링크용)
NEXT_PUBLIC_SITE_URL=https://ant-cleaning.web.app

# 텔레그램 봇 (서버/Functions에서 사용)
TELEGRAM_BOT_USERNAME=AntCleaningBot
